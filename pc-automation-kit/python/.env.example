# Copy to .env and fill in. NEVER commit .env.

# ── RFC (PyRFC) — main path ──
SAP_ASHOST=btp.tli-usa.local
SAP_SYSNR=00
SAP_CLIENT=100
SAP_USER=
SAP_PASSWD=
SAP_LANG=EN
# SAP_SAPROUTER=
# Load-balanced logon instead of ASHOST/SYSNR:
# SAP_MSHOST=
# SAP_SYSID=
# SAP_GROUP=PUBLIC

# ── HTTPS (alternative, same as the MCP) ──
BW_URL=https://btp.tli-usa.local:44300
BW_USER=
BW_PASSWORD=
BW_CLIENT=100
BW_LANGUAGE=EN
# SAP_CA_BUNDLE=path\to\client-ca.pem

# ── Recovery settings ──
MAX_ATTEMPTS=3
RETRY_WAIT_SECONDS=300
