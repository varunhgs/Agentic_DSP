# Copy to migration/.env (git-ignored) and fill in.
# Datasphere — OAuth client with purpose "Technical User" and a scoped role on the space.
DSP_HOST=https://<tenant>.<region>.hcs.cloud.sap
DSP_SPACE=<SPACE_ID>
DSP_CLIENT_ID='<client id>'
DSP_CLIENT_SECRET='<client secret>'
DSP_TOKEN_URL=https://<tenant>.authentication.<region>.hana.ondemand.com/oauth/token

# BW — optional. When unset, the BW_* variables of the "bw-modeling" server in ../.mcp.json are used.
# BW_URL=
# BW_USER=
# BW_PASSWORD=
# BW_CLIENT=
# BW_LANGUAGE=EN
