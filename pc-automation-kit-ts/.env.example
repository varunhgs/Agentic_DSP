# Copy to .env and fill in. Used by `npm run smoke`. NEVER commit .env.
# The MCP server itself gets the same variables from the "env" block in .mcp.json.

BW_URL=https://<host>:<https-port>
BW_USER=
BW_PASSWORD=
BW_CLIENT=100
BW_LANGUAGE=EN

# Only for SSO-only systems (instead of BW_USER / BW_PASSWORD):
# BW_COOKIE_FILE=C:\path\to\cookies.txt

# Session diagnostics to stderr (prints cookies — local use only):
# BW_DEBUG_SESSION=1
