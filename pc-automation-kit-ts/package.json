{
  "name": "bw-pc-automation-mcp",
  "version": "0.1.0",
  "description": "MCP server for SAP BW process chain monitoring and recovery (derived from bw-modeling-mcp)",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "bw-pc-automation-mcp": "dist/stdio.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/stdio.js",
    "dev": "tsc && node dist/stdio.js",
    "start:http": "node dist/http.js",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@arc-mcp/xsuaa-auth": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.7.0",
    "express": "^5.2.1",
    "fast-xml-parser": "^4.3.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "license": "MIT"
}
